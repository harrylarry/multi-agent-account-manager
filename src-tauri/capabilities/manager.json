{
  "identifier": "manager-local-only",
  "description": "Grant account management commands strictly to the local manager webview",
  "local": true,
  "windows": [
    "main",
    "manager"
  ],
  "webviews": [
    "manager"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-manager-state",
    "allow-select-provider",
    "allow-add-account",
    "allow-rename-account",
    "allow-remove-account",
    "allow-reorder-accounts",
    "allow-switch-account",
    "allow-set-modal-active",
    "allow-open-official-site",
    "allow-resolve-uuid-conflict",
    "allow-dismiss-notice",
    "allow-trigger-quota-sync",
    "allow-check-for-updates",
    "allow-download-and-install-update",
    "allow-open-external-url",
    "allow-muse-native-diagnose",
    "allow-muse-native-watch-probe",
    "allow-muse-native-approvals-probe",
    "allow-muse-native-quota-probe",
    "allow-muse-native-send-probe",
    "allow-muse-native-fingerprint-probe",
    "allow-muse-native-proxy-probe",
    "allow-muse-native-set-account-proxy",
    "allow-muse-native-get-account-proxy",
    "allow-muse-native-clear-account-proxy",
    "allow-muse-native-cancel-probe",
    "allow-muse-native-liveness-start",
    "allow-muse-native-liveness-status",
    "allow-muse-native-lease-probe"
  ]
}
