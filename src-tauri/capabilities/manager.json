{
  "identifier": "manager-local-only",
  "description": "Grant account management commands strictly to the local manager webview",
  "local": true,
  "windows": [
    "main",
    "manager"
  ],
  "webviews": [
    "manager"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-manager-state",
    "allow-select-provider",
    "allow-add-account",
    "allow-rename-account",
    "allow-remove-account",
    "allow-reorder-accounts",
    "allow-switch-account",
    "allow-set-modal-active",
    "allow-open-official-site",
    "allow-resolve-uuid-conflict",
    "allow-dismiss-notice",
    "allow-trigger-quota-sync",
    "allow-preview-account-cookies",
    "allow-export-account-backup",
    "allow-manage-lan-backup",
    "allow-ios-network-preferences",
    "allow-preview-account-backup",
    "allow-local-data-protection",
    "allow-restore-account-backup",
    "allow-transfer-account-cookies",
    "allow-inspect-account-cookies",
    "allow-list-muse-sessions",
    "allow-open-muse-thread",
    "allow-check-for-updates",
    "allow-download-and-install-update",
    "allow-open-external-url",
    "allow-muse-native-diagnose",
    "allow-muse-native-watch-probe",
    "allow-observe-account-tasks",
    "allow-stop-foreground-task-watch",
    "allow-set-account-task-notifications",
    "allow-hark-native-watch-probe",
    "allow-hark-isolated-send-probe",
    "allow-hark-fingerprint-ready",
    "allow-hark-fingerprint-probe",
    "allow-hark-recover-replies",
    "allow-muse-native-approvals-probe",
    "allow-decide-muse-approval",
    "allow-process-approval-notification-actions",
    "allow-muse-native-quota-probe",
    "allow-spike-ios-quota-sync-probe",
    "allow-muse-native-send-probe",
    "allow-muse-native-fingerprint-probe",
    "allow-set-muse-fingerprint-settings",
    "allow-muse-native-proxy-probe",
    "allow-muse-native-set-account-proxy",
    "allow-muse-native-get-account-proxy",
    "allow-manage-proxy-pool",
    "allow-measure-account-proxy",
    "allow-apply-proxy-pool-entry",
    "allow-muse-native-clear-account-proxy",
    "allow-muse-native-cancel-probe",
    "allow-muse-native-liveness-start",
    "allow-muse-native-liveness-status",
    "allow-muse-native-lease-probe",
    "allow-update-iphone-glass",
    "allow-delete-account-group",
    "allow-refresh-iphone-quotas",
    "allow-list-muse-thread-artifacts",
    "allow-open-hark-thread",
    "allow-list-hark-sessions",
    "allow-list-hark-thread-artifacts",
    "allow-send-new-muse-conversation",
    "allow-send-new-hark-conversation",
    "allow-check-new-muse-conversation",
    "allow-measure-proxy-pool-entry",
    "allow-is-spike-build"
  ]
}
