{
  "name": "multi-agent-account-manager",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:swift-manager": "tsc && vite build --mode swift-manager && node scripts/package-swift-manager.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "check:embedded-js": "node scripts/sync-embedded-js.mjs --check",
    "test:embedded-js": "node --test tests/embedded-js.test.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.5",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
